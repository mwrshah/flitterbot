VITE_FLITTERBOT_BASE_URL=http://127.0.0.1:18820
VITE_FLITTERBOT_TOKEN=<generated-by-installer>

# Render diagnostics: off by default; only exact "true" enables them in dev, never production.
# Restart Vite and reload the browser after changing this (hook order must stay fixed per mount).
# Logs one COMMIT line per mounted/updated app-owned component, plus tracked-value changes.
# Generated shadcn components and React/library internals are outside this instrumentation.
# Call sites use useWhyDidYouRender?.(...) so disabled tracking skips argument allocation.
# window.__WDYR_CONFIG.onlyRefChanges suppresses COMMIT lines when filtering for refs.
# VITE_DEBUG_WDYR=true
