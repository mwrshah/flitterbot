# Flitterbot environment variables
# Copy this file to .env and fill in your keys.
# The control surface loads .env automatically on startup via dotenv.

# Optional — Anthropic API key. Provider credentials can instead be configured
# from Settings → Accounts & Model providers in the Flitterbot web UI.
ANTHROPIC_API_KEY=

# Required — Groq API key for message classification router
GROQ_API_KEY=
